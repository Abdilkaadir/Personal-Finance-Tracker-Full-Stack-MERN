# The server port. Use a different port if 5000 is already in use.
PORT=5000

# Set to development for your local MongoDB database.
NODE_ENV=development
# Set to production when deploying and using MongoDB Atlas.
# NODE_ENV=production

# Local development database connection.
MONGO_URI_DEV=mongodb://127.0.0.1:27017/personal-finance-tracker

# Production MongoDB Atlas connection. Replace every placeholder in your real .env file.
MONGO_URI_PRO=mongodb+srv://<user>:<password>@cluster0.mongodb.net/personal-finance-tracker

# Use a long, unique, private value in your real .env file.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Swagger / Deployment
SERVER_URL=http://localhost:5000
